# ============================================================
#  Required
# ============================================================

# From @BotFather on Telegram: /newbot, then copy the token.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ============================================================
#  Translation engine
#  opus   = Claude Opus 5   - best quality, ~$0.005/message
#  sonnet = Claude Sonnet 5 - recommended default, ~$0.002/message
#  google = Google Translate - no conversation context, ~$0.005/message
# ============================================================
ENGINE=sonnet

# Required for ENGINE=opus and ENGINE=sonnet. https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required only for ENGINE=google.
# GOOGLE_TRANSLATE_API_KEY=

# Thinking depth for the Claude engines: low | medium | high.
# `low` is right for everyday chat. Raise it for dense theological wording.
EFFORT=low

# How long the cached system prompt survives between messages.
#   1h = costs 2x input rate to write, but survives gaps between bursts of
#        chat. Best for a normal church group. (default)
#   5m = cheaper per write (1.25x); better only for continuously busy chats.
ANTHROPIC_CACHE_TTL=1h

# ============================================================
#  Spend cap (Claude engines only)
#
#  The bot tracks its own estimated spend and stops calling the
#  API once this is reached. Set 0 to disable the guard.
#
#  IMPORTANT: this is enforced by the bot from its own accounting,
#  not by Anthropic. It does not cover spend from anything else
#  using the same key, and it cannot stop usage if this process
#  loses its state file. Set a real hard limit in the Anthropic
#  Console too: console.anthropic.com -> Settings -> Limits
# ============================================================
ANTHROPIC_MAX_COST_USD=10

# monthly = resets on the 1st (UTC), matching API billing
# total   = a lifetime cap that never resets on its own
ANTHROPIC_BUDGET_PERIOD=monthly

# DM the admins once this much budget or less remains. 0 disables the warning.
ANTHROPIC_ALERT_REMAINING_USD=5

# Telegram user IDs that receive budget alerts and may run "/budget reset".
# Get yours by messaging @userinfobot.
#
# Each admin MUST send /start to the bot in a private chat once - Telegram
# forbids bots from messaging people who have never contacted them first.
# Verify delivery any time with "/budget test".
# ADMIN_USER_IDS=123456789

# ============================================================
#  Delivery mode
# ============================================================

# polling = no public URL needed, works anywhere. Start here.
# webhook = needs a public HTTPS origin; cheaper at idle, scales to zero.
MODE=polling

# Only used when MODE=webhook.
# WEBHOOK_DOMAIN=https://your-app.fly.dev
# WEBHOOK_PATH=/telegraf/webhook
# WEBHOOK_SECRET=some-random-string-A-Za-z0-9_-
PORT=8080

# ============================================================
#  Behaviour
# ============================================================

# Languages this bot translates between (at least two).
LANGUAGES=en,ko,es

# How many earlier messages are shown to the engine as context.
# This is what makes short replies and dropped subjects translate correctly.
# 0 disables context entirely; 6 is a good balance of quality and cost.
CONTEXT_TURNS=6

# In group chats:
#   all     - translate every message
#   mention - only when the bot is @mentioned or replied to
#   command - only on /tr
GROUP_MODE=all

# Comma-separated chat IDs. Leave empty to let anyone use the bot.
# ALLOWED_CHAT_IDS=-1001234567890

STATE_FILE=./data/state.json
GLOSSARY_FILE=./glossary.json
LOG_LEVEL=info
