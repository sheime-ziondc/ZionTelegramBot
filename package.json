{
  "name": "zion-telegram-bot",
  "version": "1.0.0",
  "description": "Context-aware English/Korean/Spanish translation bot for Telegram",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "dotenv": "^17.2.3",
    "telegraf": "^4.16.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
